{
  "manifest_version": 3,
  "name": "AI Studio Tab Lister",
  "version": "1.3.0",
  "description": "Lists open Google AI Studio tabs in the context menu for quick switching.",
  "permissions": [
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Studio Tab Lister"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}